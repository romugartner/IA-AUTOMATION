      "parameters": {
        "jsCode": "const bloques = $input.all().map(item => item.json); // un bloque por item\n\nconst textoLimpio = bloques\n  .map(block => {\n    const tipo = block.type;\n    if (block[tipo] && block[tipo].rich_text) {\n      return block[tipo].rich_text.map(t => t.plain_text).join('');\n    }\n    return '';\n  })\n  .filter(t => t.trim() !== '')\n  .join(' ');\n\nreturn [{ json: { textoRAG: textoLimpio } }];"
      },
